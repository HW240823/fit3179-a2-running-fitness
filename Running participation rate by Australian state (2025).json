{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Running participation rate by Australian state (2025)",
  "data": {
    "url": "https://raw.githubusercontent.com/HW240823/fit3179-a2-running-fitness/refs/heads/main/running_by_state_2025.csv",
    "format": {"type": "csv"}
  },
  "mark": {"type": "bar", "color": "#4C78A8"},
  "encoding": {
    "x": {
      "field": "state",
      "type": "nominal",
      "sort": "-y",
      "title": "State or territory"
    },
    "y": {
      "field": "participation_rate",
      "type": "quantitative",
      "axis": {"format": ".0%", "title": "Participation rate"}
    },
    "tooltip": [
      {"field": "state", "type": "nominal", "title": "State"},
      {
        "field": "participation_rate",
        "type": "quantitative",
        "format": ".1%",
        "title": "Participation rate"
      }
    ]
  },
  "config": {}
}