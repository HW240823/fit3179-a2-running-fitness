{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Running Participation Rate by State (2025)",
  "width": 500,
  "height": 320,
  "data": {
    "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson",
    "format": {"type": "json", "property": "features"}
  },
  "transform": [
    {
      "calculate": "datum.properties.STATE_NAME === 'Australian Capital Territory' ? 'ACT' : datum.properties.STATE_NAME === 'New South Wales' ? 'NSW' : datum.properties.STATE_NAME === 'Northern Territory' ? 'NT' : datum.properties.STATE_NAME === 'Queensland' ? 'QLD' : datum.properties.STATE_NAME === 'South Australia' ? 'SA' : datum.properties.STATE_NAME === 'Tasmania' ? 'TAS' : datum.properties.STATE_NAME === 'Victoria' ? 'VIC' : datum.properties.STATE_NAME === 'Western Australia' ? 'WA' : null",
      "as": "state"
    },
    {
      "lookup": "state",
      "from": {
        "data": {
          "url": "https://raw.githubusercontent.com/HW240823/fit3179-a2-running-fitness/refs/heads/main/running_by_state_2025.csv",
          "format": {"type": "csv"}
        },
        "key": "state",
        "fields": ["participation_rate"]
      }
    }
  ],
  "projection": {"type": "equalEarth"},
  "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 1.5},
  "encoding": {
    "color": {
      "field": "participation_rate",
      "type": "quantitative",
      "title": "Participation rate",
      "scale": {"scheme": "blues"},
      "legend": {"format": ".0%"}
    },
    "tooltip": [
      {"field": "state", "type": "nominal", "title": "State"},
      {
        "field": "participation_rate",
        "type": "quantitative",
        "title": "Participation rate",
        "format": ".1%"
      }
    ]
  },
  "config": {}
}