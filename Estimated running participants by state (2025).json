{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": {
    "text": "Estimated running participants by state (2025)",
    "subtitle": "Circle size shows estimated participant numbers; markers indicate approximate state centres."
  },
  "width": 700,
  "height": 450,
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/rowanhogan/australian-states/master/states.geojson"
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E9EEF2",
        "stroke": "white",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/HW240823/fit3179-a2-running-fitness/refs/heads/main/running_counts_by_state_2025.csv",
        "format": {"type": "csv"}
      },
      "transform": [
        {
          "calculate": "datum.state === 'ACT' ? 149.0 : datum.state === 'NSW' ? 146.5 : datum.state === 'NT' ? 133.8 : datum.state === 'QLD' ? 144.0 : datum.state === 'SA' ? 135.5 : datum.state === 'TAS' ? 146.5 : datum.state === 'VIC' ? 144.2 : 121.6",
          "as": "longitude"
        },
        {
          "calculate": "datum.state === 'ACT' ? -35.5 : datum.state === 'NSW' ? -32.5 : datum.state === 'NT' ? -19.3 : datum.state === 'QLD' ? -21.0 : datum.state === 'SA' ? -30.5 : datum.state === 'TAS' ? -42.0 : datum.state === 'VIC' ? -36.9 : -25.6",
          "as": "latitude"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#D55E00",
        "opacity": 0.82,
        "stroke": "white",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "estimated_participants",
          "type": "quantitative",
          "scale": {"type": "sqrt", "range": [70, 1100]},
          "legend": {
            "title": "Estimated participants",
            "values": [50000, 250000, 500000, 750000, 1000000],
            "format": ".2s"
          }
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State or territory"},
          {
            "field": "estimated_participants",
            "type": "quantitative",
            "title": "Estimated participants",
            "format": ",.0f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "title": {"fontSize": 18, "anchor": "middle"},
    "legend": {"labelFontSize": 11, "titleFontSize": 12}
  }
}